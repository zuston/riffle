store_type = "MEMORY_LOCALFILE"
grpc_port = 21101
urpc_port = 22201
http_port = 19999
coordinator_quorum = ["uniffle-coordinator:21000"]
tags = ["riffle2", "datanode", "GRPC", "ss_v5", "GRPC_NETTY"]

[urpc_config]
get_index_rpc_version = 'V2'

[memory_store]
capacity = "2G"
dashmap_shard_amount = 128

[localfile_store]
data_paths = ["/tmp/riffle-server-2/data"]
min_number_of_available_disks = 0
write_concurrency_per_disk = 4
disk_high_watermark = 1.0

[hybrid_store]
memory_spill_high_watermark = 0.5
memory_spill_low_watermark = 0.2

[runtime_config]
read_thread_num = 20
localfile_write_thread_num = 50
http_thread_num = 5
default_thread_num = 10
dispatch_thread_num = 5

[metrics]
# Pushgateway delivery is disabled; metrics remain available at /metrics.

[log]
path = "/tmp/riffle-server-2/log"
rotation = "Never"
